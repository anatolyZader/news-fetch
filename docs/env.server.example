# Root `.env` — server & NewsAPI (copy values; do not commit `.env`)

# Required: NewsAPI.ai
NEWSAPI_API_KEY=

# Google Trends tab (DataForSEO — live data on cloud servers; credentials from https://app.dataforseo.com/api-access)
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# --- Identity Platform (optional: leave unset for public API) ---
# Set AUTH_REQUIRED=true to require sign-in for /api/* and /articles
AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
# Production: FIREBASE_CHECK_REVOKED=true (required at startup)
# Production: do NOT set GOOGLE_APPLICATION_CREDENTIALS — use runtime service account / workload identity
# Production defaults: listed-user gate on; signup off (see validateProductionSecurity)
# AUTH_REQUIRE_LISTED_USER=true
# AUTH_DISABLE_SIGNUP=true
# FIREBASE_CHECK_REVOKED=true
# APP_CHECK_ENFORCE=true
# VITE_APP_CHECK_SITE_KEY=  (client build — see client/.env.local)
# SYNC_USER_CLAIMS_ON_START=true
# OPERATOR_DISTRICT_ENFORCEMENT_ENABLED=true
# ENABLE_STRICT_CSP=true
# ENABLE_HSTS=true
# TRUST_PROXY=true

# Security alerts (optional — CI and post-deploy scripts)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SECURITY_CHAT_ID=

# Probe HMAC (production)
# RESILIENCE_PROBE_HMAC_SECRET=
# RESILIENCE_PROBE_HMAC_ROTATED_AT=2026-01-15

# Main-site narrative focus (hides Action compass, Decision brief, attention queue, suggested actions)
# RESILIENCE_NARRATIVE_FOCUS_UI=1
# RESILIENCE_DECISION_BRIEF_ENABLED=0   # optional; saves LLM on assess when narrative focus is on
# RESILIENCE_ACTION_COMPASS=0           # optional; skips compass build when narrative focus is on

# Local only: path to service account JSON (see docs/IDENTITY_PLATFORM_SETUP.md)
# Cloud Run: omit if the runtime service account has Identity Toolkit permissions
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
