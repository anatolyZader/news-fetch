{
  "name": "news",
  "version": "1.0.0",
  "description": "Fastify app – Ynet.co.il articles (same day, Hebrew) via NewsAPI.ai",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "ajv": "^8.18.0",
    "cohere-ai": "^7.21.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.7.0",
    "google-trends-api": "^4.9.2",
    "googleapis": "^144.0.0",
    "jsonrepair": "^3.13.3",
    "openai": "^4.104.0",
    "telegram": "^2.26.22",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.3"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sonar:issues": "node scripts/sonar/list-sonar-issues.mjs --all-issues --json",
    "sonar:issues:local": "node scripts/sonar/list-sonar-issues.mjs --local-only --all-issues --json",
    "sonar:verify": "node scripts/sonar/verify-sonar-issue.mjs",
    "sonar:loop": "node scripts/sonar/fix-sonar-loop.mjs",
    "test": "node --test --test-concurrency=1 $(find tests -name '*.test.js' -type f | sort)",
    "test:coverage": "mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=**/node_modules/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info $(find tests -name '*.test.js' -type f | sort)",
    "check:engines": "node scripts/check-node-engines.mjs",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "docs:check": "node scripts/docs/validate-docs.js",
    "docs:sync": "node scripts/docs/sync-overarching-docs.js",
    "articles-to-md": "node business_modules/news-sites/input/fetch-articles-to-md.js",
    "homefront-to-md": "node business_modules/news-sites/input/extract-homefront-articles.js",
    "extract-signals": "node business_modules/resilience/input/extract-signals.js",
    "extract-observations": "node business_modules/signals_extraction/input/extract-observations.js",
    "assess-signals": "node business_modules/resilience/input/assess-signals.js",
    "suggest-tuning": "node business_modules/resilience/tuning/scripts/suggestComponentTuning.js",
    "validation:status": "node business_modules/resilience/validation/scripts/validationStatus.js",
    "validation:set-phase": "node business_modules/resilience/validation/scripts/validationSetPhase.js",
    "catalog-learning:gap-report": "node business_modules/catalogLearning/input/generate-gap-report.js",
    "golden:build-corpus": "node business_modules/resilience/tuning/golden/buildCorpus.mjs",
    "ingest-field-reports": "node business_modules/visits/input/visitsInput.js",
    "audio-to-md": "node business_modules/audio/input/audio-to-md.js",
    "video-grab-url": "node business_modules/video/input/video-grab-url.js",
    "youtube-to-md": "node business_modules/video/input/youtube-to-md.js",
    "analyze-event-log": "node business_modules/pbo_report_muni/input/analyze-event-log.js",
    "analyze-survey": "node cross-cut-modules/geo/input/runAnalyzeSurvey.js",
    "build:north-reference": "node business_modules/geo/input/buildNorthReferenceFromRegions.js",
    "audit:ci": "node scripts/ci-audit.mjs",
    "deps:audit": "node scripts/audit-dependencies.mjs",
    "backfill:report-brief": "node business_modules/resilience/input/backfillReportBriefMd.js",
    "taxonomy:gap-audit": "node business_modules/resilience/tuning/scripts/taxonomyGapAudit.mjs",
    "test-tokens": "node cross-cut-modules/budget/input/test-token-usage.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:watch": "cd client && npm run build -- --watch",
    "analyst:dev": "cd analyst-site && npm run dev",
    "analyst:build": "cd analyst-site && npm run build",
    "check-identity-env": "node utils/check-identity-env.js",
    "capture:test": "node business_modules/scheduled_stream_capture/input/test-stream.js",
    "capture:jobs": "node business_modules/scheduled_stream_capture/input/manage-jobs.js",
    "capture:start": "node business_modules/scheduled_stream_capture/input/start-scheduler.js",
    "record:test": "npm run capture:test",
    "record:jobs": "npm run capture:jobs",
    "record:start": "npm run capture:start",
    "radio:setup": "node business_modules/radio/input/setup-tzafon.js",
    "radio:test": "npm run capture:test -- --url https://radio.streamgates.net/stream/1045fm",
    "radio:jobs": "npm run capture:jobs",
    "whatsapp-to-md": "node business_modules/whatsapp/input/whatsapp-to-md.js",
    "mail:digest": "node business_modules/mailing/input/runDailyDigest.js",
    "archive:purge": "node db/input/purgeSourceArchive.js",
    "archive:backfill": "node db/input/backfillSourceArchive.js",
    "rag:reindex": "node db/input/reindexRag.js",
    "rag:reindex-catalog": "node business_modules/catalogLearning/input/reindex-catalog.js",
    "rag:reindex-field-examples": "node business_modules/report_build/input/reindex-field-examples.js",
    "rag:reindex-hfc": "node cross-cut-modules/retrieval/input/reindex-hfc.js",
    "rag:reindex-social-examples": "node business_modules/social_media/input/reindex-social-examples.js",
    "rag:reindex-docs": "node cross-cut-modules/retrieval/input/reindex-docs.js",
    "rag:reindex-terms": "node cross-cut-modules/retrieval/input/reindex-terms.js",
    "rag:eval": "node db/input/ragEval.js",
    "trends:warm-cache": "node business_modules/search_trends/input/warmTrendsCache.js",
    "social-media:init": "node business_modules/social_media/input/socialMediaInput.js init",
    "social-media:gather-daily": "node business_modules/social_media/input/socialMediaInput.js gather-daily",
    "social-media:treat": "node business_modules/social_media/input/socialMediaInput.js treat",
    "social-media:telegram-session": "node business_modules/social_media/input/telegramSessionBootstrap.js"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.35.1",
    "ajv-formats-draft2019": "^1.6.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.7.0",
    "libxmljs2": "^0.37.0"
  }
}
