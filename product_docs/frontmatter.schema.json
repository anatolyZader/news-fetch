{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Srulik's lab product docs frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "intent", "audience", "stability"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "intent": {
      "type": "string",
      "enum": ["getting-started", "concepts", "guides", "api", "architecture", "operations", "playbooks"]
    },
    "audience": {
      "type": "array",
      "items": { "type": "string", "enum": ["public", "customer", "internal"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "stability": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "canonical": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunkHint": { "type": "string" }
      }
    }
  }
}

