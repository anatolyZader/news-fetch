# DB + reports (runtime/generated)
# Root-only: do not ignore e.g. business_modules/geo/data/ (versioned reference JSON).
/db/
# Video fetches (yt-dlp MP3, subtitles, retained audio) — keep .gitkeep only
business_modules/video/data/**
!business_modules/video/data/.gitkeep
# Stream captures (scheduled radio) — keep .gitkeep only
business_modules/recording/data/**
!business_modules/recording/data/.gitkeep
reports/
/validation/
business_modules/resilience/validation/artifacts/
# Application logs (cost JSONL, pipeline text) — keep .gitkeep only
cross-cut-modules/log/data/**
!cross-cut-modules/log/data/.gitkeep
# Report bot manual-report inbox — keep .gitkeep only
business_modules/report_bot/data/**
!business_modules/report_bot/data/.gitkeep

