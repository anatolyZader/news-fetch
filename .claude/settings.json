{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run *)",
      "Bash(mkdir -p logs)",
      "Bash(mkdir -p logs && *)",
      "Bash(for date in *)",
      "Bash(tail * logs/*)",
      "Bash(*>> logs/*)",
      "Bash(* 2>> logs/*)",
      "Bash(export RESILIENCE_OPEN_EXTRACT_PARALLEL=1)",
      "Bash(export RESILIENCE_OPEN_EXTRACT_PARALLEL=1*)",
      "Bash(export RESILIENCE_OPEN_EXTRACT_PARALLEL=1 && *)",
      "Bash(echo * >> logs/*)",
      "Bash(echo * 2>> logs/*)",
      "Bash(node business_modules/*)",
      "Bash(echo \"Exit: $?\")",
      "Bash(echo \"exit: $?\")",
      "Bash(echo *:+SET*)",
      "Bash(echo *X_BEARER_TOKEN*)",
      "Bash(echo *TELEGRAM_*)",
      "Bash(cd /home/eventstorm1/news && *)",
      "Bash(cd /home/eventstorm1/news && * > logs/*)",
      "Bash(cd /home/eventstorm1/news && * >> logs/*)",
      "Bash(cd /home/eventstorm1/news && * 2> logs/*)",
      "Bash(cd /home/eventstorm1/news && * 2>> logs/*)",
      "Write(logs/**)",
      "Edit(logs/**)",
      "Bash(cat /proc/29821/cmdline | tr '\\\\0' ' ' && echo && ls -la /proc/29821/cwd 2>/dev/null)",
      "Read(//proc/29821/**)",
      "Bash(sort -k6,7)",
      "Bash(command -v qrencode)",
      "Bash(command -v python3)",
      "Bash(pip install *)",
      "Bash(awk '{print $5, $9}')",
      "Bash(systemctl list-units *)",
      "Bash(ls \"$HOME/.cache/ms-playwright/\" 2>/dev/null; which pdftoppm convert magick 2>/dev/null; echo \"---\"; ls /home/eventstorm1/news/promo/screenshots/*.png 2>/dev/null)",
      "Read(//home/eventstorm1/.cache/ms-playwright/**)",
      "Bash(/home/eventstorm1/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome --headless --disable-gpu --no-sandbox --print-to-pdf=promo/print/brochure-hq-en-rich.pdf --print-to-pdf-no-header file://__CMDSUB_OUTPUT__/promo/print/brochure-hq-en-rich.html)",
      "Bash(/home/eventstorm1/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=900,4650 --screenshot=/tmp/claude-1002/-home-eventstorm1-news/a0316731-85d3-43bd-8c45-107356b2b5e7/scratchpad/brochure-rich-preview.png file://__CMDSUB_OUTPUT__/promo/print/brochure-hq-en-rich.html)",
      "Bash(/home/eventstorm1/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=900,4650 --screenshot=/tmp/claude-1002/-home-eventstorm1-news/a0316731-85d3-43bd-8c45-107356b2b5e7/scratchpad/brochure-rich-preview3.png file://__CMDSUB_OUTPUT__/promo/print/brochure-hq-en-rich.html)",
      "Bash(/home/eventstorm1/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=900,4650 --screenshot=/tmp/claude-1002/-home-eventstorm1-news/a0316731-85d3-43bd-8c45-107356b2b5e7/scratchpad/brochure-rich-preview4.png file://__CMDSUB_OUTPUT__/promo/print/brochure-hq-en-rich.html)",
      "Bash(/home/eventstorm1/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome --headless --disable-gpu --no-sandbox --hide-scrollbars --window-size=900,4650 --screenshot=/tmp/claude-1002/-home-eventstorm1-news/a0316731-85d3-43bd-8c45-107356b2b5e7/scratchpad/brochure-v5.png file://__CMDSUB_OUTPUT__/promo/print/brochure-hq-en-rich.html)",
      "Bash(echo \"clean: $?\")",
      "Bash(cd /home/eventstorm1/news *)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/home/eventstorm1/news/logs",
      "logs",
      "/home/eventstorm1/news/business_modules/epistemic_features/data/profiles"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/allow-pipeline-bash.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "./logs",
        "/home/eventstorm1/news/logs",
        "/home/eventstorm1/news/business_modules",
        "/home/eventstorm1/news/db",
        "/home/eventstorm1/news/analyst",
        "/home/eventstorm1/news/client/dist",
        "/home/eventstorm1/news/node_modules"
      ]
    }
  }
}
