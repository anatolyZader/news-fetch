{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "checkJs": false,
    "jsx": "react-jsx"
  },
  "include": [
    "app.js",
    "server.js",
    "business_modules",
    "cross-cut-modules",
    "api",
    "utils",
    "shared",
    "scripts",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "client",
    "docs-site",
    "coverage",
    "business_modules/resilience_scorer/data",
    "signals",
    "articles_extracted",
    "**/data/**",
    "db/**",
    "cross-cut-modules/docs/content/pages/api/generated"
  ]
}
