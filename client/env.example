# Rename to .env.local and fill from Firebase Console → Project settings → Web app
# .env.local is gitignored and .cursorignore — do not commit or @-mention in chat.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_APP_CHECK_SITE_KEY=   # Firebase App Check → reCAPTCHA Enterprise site key
# VITE_APP_CHECK_DEBUG_TOKEN=   # local dev only; register debug token in Firebase Console

# Optional site footer / docs overrides
# VITE_DOCS_BASE_URL=https://docs.srulik.ai
# VITE_ANALYST_SITE_URL=https://analyst.srulik.ai
# VITE_SUPPORT_EMAIL=support@example.com
